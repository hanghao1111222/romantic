#!/bin/bash
CURRENT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$CURRENT_DIR"

CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
EDGE="/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
HTML="$CURRENT_DIR/particle_rose_fullscreen.html"

if [ -f "$CHROME" ]; then
    "$CHROME" --app="file://$HTML" --start-fullscreen --hide-scrollbars &
elif [ -f "$EDGE" ]; then
    "$EDGE" --app="file://$HTML" --start-fullscreen --hide-scrollbars &
else
    python3 "$CURRENT_DIR/start_fullscreen.py" &
fi
